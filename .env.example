# Copy to .env and edit. Every value is optional; these are the defaults.
# All settings are also available as environment variables with this prefix.

# ---------------------------------------------------------------- server
CACHELLM_HOST=127.0.0.1
CACHELLM_PORT=8080
CACHELLM_LOG_LEVEL=INFO
CACHELLM_LOG_JSON=true
# Prompt and completion text is never logged unless you turn this on.
CACHELLM_LOG_PROMPTS=false

# ------------------------------------------------------------------ auth
# Comma-separated client keys. LEAVE EMPTY ONLY FOR LOCAL DEVELOPMENT:
# an unauthenticated proxy holding provider credentials is an open wallet.
CACHELLM_API_KEYS=

# --------------------------------------------------------------- storage
# Where the cache lives.
#   memory  nothing to install; searches a numpy matrix inside this process
#   redis   shared across workers, survives restarts, scales past ~100k entries
#   auto    Redis when reachable, memory when not  (the default)
#
# Memory is not a lesser option at small scale: scanning 20,000 cached prompts
# takes 0.85 ms, while a Redis round trip alone costs 2 to 3 ms.
CACHELLM_BACKEND=auto

# In-memory store. 50k entries of 384-dim vectors is roughly 73 MB.
CACHELLM_MEMORY_MAX_ENTRIES=50000
# Optional: persist the in-memory cache so a restart does not start cold.
# CACHELLM_MEMORY_SNAPSHOT_PATH=./.cachellm-snapshot.npz

# Redis, used when CACHELLM_BACKEND is redis or auto.
# Needs:  pip install "cachellm-proxy[redis]"
# Must be database 0. Redis Search cannot index any other database.
CACHELLM_REDIS_URL=redis://localhost:6379/0
CACHELLM_INDEX_NAME=cachellm_idx

# ------------------------------------------------------------ embeddings
# MiniLM is the default: on the project's evaluation corpus it gave four times
# the safe recall of bge-small, at a third of the download size.
CACHELLM_EMBEDDING_BACKEND=fastembed
CACHELLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --------------------------------------------------------------- caching
CACHELLM_ENABLED=true
# Observe-only: log what the cache WOULD have served, then call the provider
# anyway. Run this for a week on real traffic before switching it off.
CACHELLM_SHADOW_MODE=false

# Leave thresholds at 0 to use the calibrated value for your embedding model.
# Thresholds do NOT transfer between models: the measured safe points across
# six models span 0.89 to 0.98. Run `python -m bench.compare_models` on your
# own data before overriding these.
CACHELLM_THRESHOLD_DEFAULT=0
CACHELLM_THRESHOLD_FACTUAL=0
CACHELLM_THRESHOLD_CLASSIFICATION=0
CACHELLM_THRESHOLD_CREATIVE=0

# Time to live, in seconds, per prompt category.
CACHELLM_TTL_FACTUAL=604800
CACHELLM_TTL_VOLATILE=900
CACHELLM_TTL_DEFAULT=86400

# ---------------------------------------------------- cacheability rules
CACHELLM_MAX_CACHEABLE_TEMPERATURE=0.3
CACHELLM_CACHE_MULTI_TURN=false
CACHELLM_CACHE_JSON_MODE=false
CACHELLM_CACHE_TOOL_CALLS=false
# Skip caching prompts that look like they carry personal data.
CACHELLM_PII_GUARD=true

# ------------------------------------------------------------- providers
# bedrock needs:  pip install "cachellm-proxy[aws]"
# openai needs nothing extra, and covers OpenAI, Groq, Gemini, Ollama, vLLM
CACHELLM_DEFAULT_PROVIDER=bedrock
AWS_REGION=us-east-1
# CACHELLM_AWS_PROFILE=default
# Credentials from `aws login` need the CRT extra: uv sync --extra aws

# Store answers that stopped because they hit max_tokens. Off by default: a
# truncated answer served from cache forever is a silent quality bug. If your
# hit rate is low, check /admin/stats diagnostics before changing this.
CACHELLM_CACHE_TRUNCATED=false

# Any OpenAI-compatible upstream: OpenAI, Groq, Together, OpenRouter, vLLM.
CACHELLM_OPENAI_BASE_URL=https://api.openai.com/v1
CACHELLM_OPENAI_API_KEY=

# --------------------------------------------------------- observability
# The /metrics page is a plain text endpoint written by a ~50 KB python
# library. Prometheus and Grafana are separate programs; installing this
# package never installs either, and neither is required to run the proxy.
# /admin/stats answers the same questions without them.
CACHELLM_METRICS_ENABLED=true
CACHELLM_TRACING_ENABLED=false
# Langfuse: https://cloud.langfuse.com/api/public/otel/v1/traces
# and set OTEL_EXPORTER_OTLP_HEADERS with the basic-auth header.
CACHELLM_OTLP_ENDPOINT=
